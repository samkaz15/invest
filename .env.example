# BIOS runtime settings. Copy to `.env` and fill in. `.env` is git-ignored.
# All keys are read by bios.config.Settings (prefix BIOS_).

# Environment name: dev | prod
BIOS_ENV=dev

# Root directory for mutable runtime state (audit logs, queues). Git-ignored.
BIOS_VAR_DIR=var

# Directory holding the YAML configuration tree (config/ by default).
BIOS_CONFIG_DIR=config

# Log level: DEBUG | INFO | WARNING | ERROR
BIOS_LOG_LEVEL=INFO

# Emit logs as JSON lines (true in prod, false for human-readable dev output).
BIOS_LOG_JSON=false

# --- Secrets (added in later sprints; never commit real values) ---
# ANTHROPIC_API_KEY=
# DATABASE_URL=

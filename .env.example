# MIOS runtime settings. Copy to `.env` and fill in. `.env` is git-ignored.
# Settings prefixed MIOS_ are read by mios.config.Settings; the API keys are
# read by name from config/sources/*.yaml via ${VAR} expansion.

# --- process settings -------------------------------------------------
# Environment name: dev | prod
MIOS_ENV=dev

# Disposable runtime state (scheduler, breakers, DLQ, health). Git-ignored.
MIOS_VAR_DIR=var

# Collected raw payloads and reports. COMMITTED to the repository (ADR-010).
MIOS_DATA_DIR=data

# Directory holding the YAML configuration tree.
MIOS_CONFIG_DIR=config

# Log level: DEBUG | INFO | WARNING | ERROR
MIOS_LOG_LEVEL=INFO

# Emit logs as JSON lines (true in CI/Actions, false for readable dev output).
MIOS_LOG_JSON=false

# Managed PostgreSQL (ADR-010). Never commit a real DSN.
# MIOS_DATABASE_URL=postgresql://user:password@host:5432/mios

# --- source credentials ----------------------------------------------
# A source whose variable is unset is DISABLED and reported as a data gap,
# never silently skipped. Missing one key must not stop other collection.

# FRED / ALFRED — free key from https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Twelve Data (ADR-011) — FX, commodities, indices
# TWELVEDATA_API_KEY=

# --- later phases -----------------------------------------------------
# LLM is used for classification, summarisation and prose only, never to
# produce a number (CONSTITUTION.md Art.5). Not needed before Phase 6.
# ANTHROPIC_API_KEY=
